# Django settings module to use (development or production)
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key - MUST be changed for production
DJANGO_SECRET_KEY=change-me-in-production

# Debug mode - NEVER use True in production
DJANGO_DEBUG=True

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Static files root (optional, defaults to backend/staticfiles)
DJANGO_STATIC_ROOT=backend/staticfiles

# Media files root (optional, defaults to backend/media)
DJANGO_MEDIA_ROOT=backend/media

# Log directory (optional, defaults to backend/logs)
DJANGO_LOG_DIR=backend/logs

# Log level (optional, defaults to INFO)
DJANGO_LOG_LEVEL=INFO

# Health check endpoint (optional, defaults to true)
HEALTH_CHECK_ENABLED=true

# Database configuration
DB_NAME=gm_db
DB_USER=gm_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS allowed origins (comma-separated, e.g. http://example.com,http://www.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF trusted origins (comma-separated, e.g. https://example.com,https://www.example.com)
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Waitress / WSGI port (internal port for Waitress, not exposed directly)
DJANGO_PORT=8000

# HTTPS / Security settings (production only)
# Set to true when deploying behind HTTPS
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
